{
  "$schema":"https://schema.tauri.app/config/2",
  "productName":"EasyNovel", "version":"0.2.0", "identifier":"com.easynovel.studio",
  "build": {"beforeDevCommand":"npm --prefix ../web run dev -- --host 127.0.0.1", "devUrl":"http://127.0.0.1:5173", "beforeBuildCommand":"npm --prefix ../web run build", "frontendDist":"../../web/dist"},
  "app": {
    "windows":[{"label":"main","title":"EasyNovel 小说创作工作站","width":1440,"height":960,"minWidth":900,"minHeight":650}],
    "security":{"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self'; object-src 'none'; base-uri 'self'"}
  },
  "bundle":{"active":true,"targets":["nsis"],"externalBin":["binaries/easynovel-backend"],"icon":["icons/icon.png","icons/icon.ico"],"windows":{"nsis":{"installMode":"currentUser","languages":["SimpChinese","English"],"displayLanguageSelector":true},"webviewInstallMode":{"type":"downloadBootstrapper","silent":true}}}
}
