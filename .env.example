# AI Novel Studio - Environment Variables
# Copy this file to .env and fill in your values

# OpenAI-compatible model provider.
# DeepSeek is the default, but any compatible endpoint can be used.
MODEL_PROVIDER=deepseek
MODEL_API_KEY=sk-your-model-api-key-here
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_FLASH=deepseek-v4-flash
MODEL_PRO=deepseek-v4-pro
MODEL_TIMEOUT_SECONDS=60

# Backward-compatible DeepSeek variables are still supported.
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Database URL
# SQLite (development):
DATABASE_URL=sqlite:///./ai_novel_studio.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_novel_studio

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Frontend API target
REACT_APP_API_BASE_URL=http://localhost:8000

# Debug mode (true/false)
DEBUG=false
